{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug f1",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Pressure_Sensor_SAUVC.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "device": "stm32f1x",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "showDevDebugOutput": "raw",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ]
        },
        {
            "name": "Renode debug",
            "type": "cppdbg",
            "request": "launch",
            "miDebuggerServerAddress": "localhost:3333",
            "cwd": "${workspaceRoot}",
            "miDebuggerPath": "gdb-multiarch",
            "program": "build/Debug/Pressure_Sensor_SAUVC.elf"
        },
    ]
}
